{
    "name": "woomoza/mpesa",
    "description": "SDK M-Pesa Moçambique (Vodacom) independente: C2B, B2C, B2B, Reversal, Query, Query Customer Name e callbacks.",
    "type": "library",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.11"
    },
    "autoload": {
        "psr-4": {
            "Woomoza\\Mpesa\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Woomoza\\Mpesa\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse -c phpstan.neon.dist --memory-limit=512M"
    },
    "config": {
        "sort-packages": true
    }
}
