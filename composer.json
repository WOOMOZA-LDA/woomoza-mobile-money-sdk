{
    "name": "woomoza/mobile-money-sdk",
    "description": "Unofficial PHP SDK for Mozambique mobile money wallets (M-Pesa first). No runtime dependencies.",
    "type": "library",
    "license": "MIT",
    "keywords": ["mpesa", "m-pesa", "mobile-money", "mozambique", "vodacom", "payments", "sdk"],
    "homepage": "https://github.com/WOOMOZA-LDA/woomoza-mobile-money-sdk",
    "support": {
        "issues": "https://github.com/WOOMOZA-LDA/woomoza-mobile-money-sdk/issues",
        "source": "https://github.com/WOOMOZA-LDA/woomoza-mobile-money-sdk"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.11"
    },
    "autoload": {
        "psr-4": {
            "Woomoza\\MobileMoney\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Woomoza\\MobileMoney\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse -c phpstan.neon.dist --memory-limit=512M"
    },
    "config": {
        "sort-packages": true
    }
}
